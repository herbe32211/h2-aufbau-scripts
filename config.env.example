# config.env.example — Vorlage für die reale config.env
#
#   cp config.env.example config.env && $EDITOR config.env
#
# config.env ist per .gitignore ausgeschlossen und wird NIE versioniert.
# Diese Datei enthält keine Secrets und darf keine bekommen: keine API-Keys,
# keine Tokens, keine Passwörter, kein SSH-Private-Key.
#
# Die Datei wird von lib/common.sh mit `set -a; source` eingelesen. Also:
# reines Bash-Variablen-Format, keine Kommandos, Werte mit Leerzeichen quoten.

# ---------------------------------------------------------------------------
# Identität
# ---------------------------------------------------------------------------

# Der Nicht-Root-User, unter dem der Agent später läuft.
# Absichtlich AGENT_USER und nicht USERNAME: USERNAME/HOSTNAME kollidieren mit
# vordefinierten Shell-Variablen und führen zu schwer auffindbaren Fehlern.
AGENT_USER="hermes"

# Erwarteter Hostname der VM. Wird von 10-base.sh nur geprüft und gemeldet,
# nicht gesetzt — ein Hostname-Wechsel im laufenden Betrieb ist nichts, was ein
# Bootstrap-Script nebenbei erledigen sollte.
AGENT_HOSTNAME="worker"

# Systemzeitzone. Entscheidung vom 15.08.2026: Europe/Berlin bleibt.
# Der Betriebsplan verlangt UTC ausschliesslich für log.jsonl — das ist eine
# Sache der Anwendung, nicht der Systemzeitzone. Auf "UTC" umstellbar, dann
# läuft 10-base.sh die Umstellung idempotent durch.
TIMEZONE="Europe/Berlin"

# ---------------------------------------------------------------------------
# Netz  (Modul 05-network)
#
# ALLE Netzwerte stehen hier und nirgends sonst. Die VM zieht später aus dem
# NAT-Übergangsnetz 10.42.0.0/24 ins Zielnetz 192.168.178.0/24 — dann werden
# nur diese vier Werte geändert und 05-network.sh läuft erneut.
# ---------------------------------------------------------------------------

NET_INTERFACE="ens18"
NET_ADDRESS="10.42.0.20"
NET_PREFIX="24"
NET_GATEWAY="10.42.0.1"

# Öffentliche Resolver, durch Leerzeichen getrennt, in Reihenfolge.
#
# Default sind beide Quad9-Adressen (Secure-Service: Malware-Blocklist +
# DNSSEC-Validierung, kein EDNS-Client-Subnet). Bewusst gewählt trotz des
# Nachteils, dass beide demselben Betreiber gehören — ein Quad9-Totalausfall
# nimmt der VM die Namensauflösung, und wegen der geplanten Host-Firewall
# (OUT ins LAN verboten) gibt es keinen Router als Fallback.
# Wer diesen Single Point of Failure nicht will, nimmt zwei Betreiber, z. B.
#   DNS_SERVERS="9.9.9.9 1.1.1.1"
# und verliert dafür die einheitliche Filterpolitik.
DNS_SERVERS="9.9.9.9 149.112.112.112"

# Optionale Suchdomain für resolv.conf. Leer lassen, wenn keine gewünscht ist.
DNS_SEARCH=""

# IPv6 in der VM abschalten.
# Grund: Die Firewall-Regel auf dem Proxmox-Host ist IPv4-formuliert
# ("OUT ins LAN verboten"). Bliebe IPv6 aktiv, wäre es der offene Umweg genau
# um diese Sperre herum. Deshalb Default true.
DISABLE_IPV6="true"

# ---------------------------------------------------------------------------
# Basis  (Modul 10-base)
# ---------------------------------------------------------------------------

# Zusätzliche Pakete über die fest eingebaute Grundausstattung hinaus.
# Leerzeichen-getrennt, darf leer sein.
EXTRA_PACKAGES=""

# unattended-upgrades installieren und für Sicherheitsupdates aktivieren.
# Automatische Reboots werden dabei NICHT eingeschaltet — eine Agent-VM soll
# nicht ungefragt mitten im Lauf neu starten.
INSTALL_UNATTENDED_UPGRADES="true"

# ---------------------------------------------------------------------------
# User und SSH  (Modul 20-user-ssh)
# ---------------------------------------------------------------------------

# SSH-Public-Key des Administrators, eine Zeile, Format "ssh-ed25519 AAAA... kommentar".
# NIEMALS ein Private Key. Wird vor dem Schreiben mit ssh-keygen -l validiert.
# Solange leer, überspringt das Modul sowohl authorized_keys als auch die
# sshd-Härtung — Aussperr-Schutz.
AGENT_SSH_PUBKEY=""

# Passwort-Login und Root-Login per SSH abschalten.
# Greift nur, wenn AGENT_SSH_PUBKEY gesetzt ist UND der Key danach als gültige,
# nicht-leere authorized_keys auf der Platte liegt. Danach läuft `sshd -t`;
# schlägt der Test fehl, wird das Drop-in wieder entfernt.
SSH_HARDEN="true"

# ---------------------------------------------------------------------------
# Tailscale  (Modul 40-tailscale)
# ---------------------------------------------------------------------------

# Tag, mit dem sich dieser Node im Tailnet meldet. Muss im Policy-File unter
# tagOwners existieren, BEVOR `tailscale up` läuft — sonst scheitert das Tagging.
# Siehe docs/tailscale-acl.md.
TAILSCALE_TAG="tag:h2-agent"

# ---------------------------------------------------------------------------
# Docker-Sandbox  (nur Dokumentation / 90-verify gibt den Wert aus)
#
# Das Image wird von diesen Scripts NICHT gezogen. Der Pin steht hier, damit er
# an einer Stelle gepflegt wird und beim späteren Hermes-Setup übernommen
# werden kann.
# Stand 15.08.2026 verifiziert, siehe VERIFIKATION.md Abschnitt 8.
# ---------------------------------------------------------------------------

SANDBOX_IMAGE="nikolaik/python-nodejs"
SANDBOX_IMAGE_TAG="python3.12-nodejs22"
SANDBOX_IMAGE_DIGEST="sha256:88c41488c175453b29007809b82c3059c9a55b721f14f5a5a4ea64cb995e26e7"
